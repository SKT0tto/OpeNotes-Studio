        {
          "id": "s2b3",
          "kind": "dialogue",
          "speakerId": "c_003",
          "text": "嗯。写好了就唱出来，我想听你的声音。",
          "emotion": "happy",
          "shot": {
            "type": "two_shot",
            "focus": [
              "c_003",
              "c_001"
            ],
            "move": "static"
