# Read-only external asset library (models/, backgrounds/, media/). Never copied into the repo.
ASSET_ROOT=/path/to/your/assets
# Extra audio folders, separated by ';' (optional)
AUDIO_ROOTS=
# Cubism Core runtime (default: official CDN). Point to a local copy under vendor/ for offline use.
# CUBISM_CORE_URL=https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js
API_PORT=5274

# ---- AI (optional; keys stay on the server, never sent to the browser) --------------------------------------------
# These only give defaults: whatever you save in the "AI 设置" dialog (data/settings.local.json, gitignored) wins.
# Claude:
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI-compatible (DeepSeek, LM Studio, vLLM ...):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com        # LM Studio: http://localhost:1234/v1
# OPENAI_MODEL=deepseek-flash
# OPENAI_API_KEY=                                  # may stay empty for local servers
