            "type": "cu",
            "focus": [
              "c_001"
            ],
            "move": "static"
          },
          "variant": "monologue",
          "cutIn": "dip_black",
          "cutInKeepDialog": true
        },
        {
          "id": "s2b7",
          "kind": "dialogue",
          "speakerId": "c_002",
          "text": "那天她说过，能听到你写的歌，是她最开心的事。",
          "emotion": "happy",
          "shot": {
            "type": "ecu",
            "focus": [
              "c_002"
            ],
            "move": "static"
          },
          "variant": "monologue"
        },
        {
          "id": "s2b8",
          "kind": "dialogue",
          "speakerId": "c_001",
